generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  facilities  Facility[]
  memberships OrganizationMembership[]
  auditEvents AuditEvent[]
  clinicians  Clinician[]
  specialties Specialty[]
  payers      Payer[]
  tpas        Tpa[]
  networks    Network[]
  services    Service[]
  procedureCodes ProcedureCode[]
  diagnosisCodes DiagnosisCode[]
  externalIdentifiers       ExternalIdentifier[] @relation("ExternalIdentifierOwner")
  externalIdentifierTargets ExternalIdentifier[] @relation("ExternalIdentifierOrganizationTarget")
  ruleSources RuleSource[]
  ruleDefinitions RuleDefinition[]
  rulePacks       RulePack[]
  insuranceProducts InsuranceProduct[]
  providerContracts ProviderContract[]
  patients          Patient[]
  evidenceArtifacts EvidenceArtifact[]

  @@map("organizations")
}

// A4.1 — the canonical organization-scoped person identity. Patient answers only "who is this
// person inside this Organization?". It deliberately carries no coverage, no facility, no encounter
// and no external-system identifier: InsuranceMembership (A4.3), Encounter (A4.4) and the
// ExternalIdentifier target (A4.8) attach later and stay separate. Demographics are kept small and
// jurisdiction-neutral, and are never made unique — two people can share a name and date of birth.
model Patient {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid

  givenName      String   @map("given_name") @db.Text
  middleName     String?  @map("middle_name") @db.Text
  familyName     String   @map("family_name") @db.Text
  // A calendar date, never a timestamp; age is calculated when needed, never stored.
  dateOfBirth    DateTime @map("date_of_birth") @db.Date

  mobilePhone    String?  @map("mobile_phone") @db.Text
  email          String?  @db.Text

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  insuranceMemberships InsuranceMembership[]
  encounters     Encounter[]
  externalIdentifiers ExternalIdentifier[]

  @@index([organizationId])
  @@map("patients")
}

// A4.3 — the patient-owned record of an insurance membership: which payer (and, when known, which
// TPA, network and product) this patient was registered under, the member/policy identifiers that
// were recorded, and the coverage dates that were recorded. It is registration truth, NOT
// eligibility: nothing here says coverage is verified, active, primary or billable — A5 owns that
// evidence. There is deliberately no organizationId (ownership derives from the Patient and every
// referenced master is checked against it), no status/eligible/primary/rank field, no provider
// contract or tariff, and no uniqueness on member/policy values, whose semantics belong to payers.
model InsuranceMembership {
  id                 String    @id @default(uuid()) @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  payerId            String    @map("payer_id") @db.Uuid
  tpaId              String?   @map("tpa_id") @db.Uuid
  networkId          String?   @map("network_id") @db.Uuid
  insuranceProductId String?   @map("insurance_product_id") @db.Uuid

  // Sensitive insurance identifiers: returned to authorized callers, never written to AuditEvent,
  // logs, URLs or browser storage.
  memberIdentifier   String    @map("member_identifier") @db.Text
  policyIdentifier   String?   @map("policy_identifier") @db.Text

  // Recorded calendar dates, never timestamps. Null means unknown, not "active".
  coverageFrom       DateTime? @map("coverage_from") @db.Date
  coverageTo         DateTime? @map("coverage_to") @db.Date

  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  payer              Payer             @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tpa                Tpa?              @relation(fields: [tpaId], references: [id], onDelete: Restrict)
  network            Network?          @relation(fields: [networkId], references: [id], onDelete: Restrict)
  insuranceProduct   InsuranceProduct? @relation(fields: [insuranceProductId], references: [id], onDelete: Restrict)
  encounters         Encounter[]
  eligibilityVerifications EligibilityVerification[]
  priorAuthorizations PriorAuthorization[]
  validationRuns ValidationRun[]


  @@index([patientId])
  @@index([payerId])
  @@index([insuranceProductId])
  @@index([patientId, coverageFrom])
  @@map("insurance_memberships")
}

// A4.4 — one patient service event and its authoritative operational context. The server, never the
// client, resolves the exact ClinicianFacilityAssignment (A4.2) and ACTIVE FacilityRegulatoryProfile
// (A3) effective on serviceDate and stores those IDs, so downstream packages consume the context
// that applied when the Encounter was written instead of silently reselecting it. The membership is
// optional (self-pay stays possible) and is a recorded registration, never eligibility. There is
// deliberately no organizationId (ownership derives from the Patient), no status/eligibility/claim/
// price field, no diagnosis/activity column, no specialty and no external visit ID.
model Encounter {
  id                            String   @id @default(uuid()) @db.Uuid
  patientId                     String   @map("patient_id") @db.Uuid
  facilityId                    String   @map("facility_id") @db.Uuid
  clinicianId                   String   @map("clinician_id") @db.Uuid
  insuranceMembershipId         String?  @map("insurance_membership_id") @db.Uuid

  // A calendar date, never a timestamp. Not eligibility evidence.
  serviceDate                   DateTime @map("service_date") @db.Date

  // Server-resolved at write time; never accepted from client input.
  clinicianFacilityAssignmentId String   @map("clinician_facility_assignment_id") @db.Uuid
  facilityRegulatoryProfileId   String   @map("facility_regulatory_profile_id") @db.Uuid

  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient                     Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facility                    Facility                    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  clinician                   Clinician                   @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  insuranceMembership         InsuranceMembership?        @relation(fields: [insuranceMembershipId], references: [id], onDelete: Restrict)
  clinicianFacilityAssignment ClinicianFacilityAssignment @relation(fields: [clinicianFacilityAssignmentId], references: [id], onDelete: Restrict)
  facilityRegulatoryProfile   FacilityRegulatoryProfile   @relation(fields: [facilityRegulatoryProfileId], references: [id], onDelete: Restrict)
  diagnoses                   EncounterDiagnosis[]
  activities                  EncounterActivity[]
  observations                EncounterObservation[]
  externalIdentifiers         ExternalIdentifier[]
  eligibilityVerifications    EligibilityVerification[]
  priorAuthorizations PriorAuthorization[]


  encounterEvidenceLinks EncounterEvidenceLink[]
  validationRuns ValidationRun[]
  claims Claim[]
  @@index([patientId])
  @@index([facilityId])
  @@index([clinicianId])
  @@index([insuranceMembershipId])
  @@index([serviceDate])
  @@map("encounters")
}

// A4.5 — the ordered, correctable link between one Encounter and the authoritative A2.8
// DiagnosisCode identities attached to it. Active rows (removedAt IS NULL) form a contiguous 1..N
// sequence owned by the server; a correction marks a row removed and adds a NEW row, so history is
// never overwritten or deleted. There is deliberately no organizationId/patientId (ownership derives
// from the Encounter), no code/displayName snapshot (A2.8 stays the master; A6 freezes submitted
// coding), no isPrimary/role (sequence 1 is simply the first listed) and no claim/procedure field.
model EncounterDiagnosis {
  id              String    @id @default(uuid()) @db.Uuid
  encounterId     String    @map("encounter_id") @db.Uuid
  diagnosisCodeId String    @map("diagnosis_code_id") @db.Uuid
  // 1-based position among the ACTIVE rows of the Encounter; never supplied by the client.
  sequence        Int
  // Set once when the row is removed; the row itself is kept as correction history.
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  encounter     Encounter     @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  diagnosisCode DiagnosisCode @relation(fields: [diagnosisCodeId], references: [id], onDelete: Restrict)
  validationFindings ValidationFinding[]
  claimDiagnoses     ClaimDiagnosis[]

  @@index([encounterId])
  @@index([diagnosisCodeId])
  @@index([encounterId, removedAt])
  @@map("encounter_diagnoses")
}

// A4.6 — one performed/billable activity fact captured under an Encounter: an A2.6 Service and/or
// an A2.7 ProcedureCode (at least one; no Service<->Procedure mapping is asserted), an exact
// positive Decimal quantity, an optional opaque unit code and ordered opaque modifier codes. Rows
// are append-and-remove facts: a correction marks the row removed and adds a NEW row, and nothing
// is patched or deleted. There is deliberately no organizationId/patient/context copy (ownership
// derives from the Encounter), no code/name snapshot, no sequence/line number (A6 owns ClaimLine
// order), no diagnosis pointer and no price/tariff field.
model EncounterActivity {
  id              String    @id @default(uuid()) @db.Uuid
  encounterId     String    @map("encounter_id") @db.Uuid
  serviceId       String?   @map("service_id") @db.Uuid
  procedureCodeId String?   @map("procedure_code_id") @db.Uuid

  quantity        Decimal   @db.Decimal(18, 4)
  unitCode        String?   @map("unit_code") @db.Text
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  encounter       Encounter       @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  service         Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  procedureCode   ProcedureCode?  @relation(fields: [procedureCodeId], references: [id], onDelete: Restrict)
  modifiers       EncounterActivityModifier[]
  observations    EncounterObservation[]
  validationFindings ValidationFinding[]
  claimLineSources   ClaimLineSourceActivity[]
  pricingLineResults ClaimPricingLineResult[]

  @@index([encounterId])
  @@index([serviceId])
  @@index([procedureCodeId])
  @@index([encounterId, removedAt])
  @@map("encounter_activities")
}

// A4.6 — the ordered modifier codes of one EncounterActivity (sequence 1..N in supplied order).
// Immutable children: removing the activity leaves them untouched as history.
model EncounterActivityModifier {
  id                  String   @id @default(uuid()) @db.Uuid
  encounterActivityId String   @map("encounter_activity_id") @db.Uuid
  sequence            Int
  code                String   @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  encounterActivity EncounterActivity @relation(fields: [encounterActivityId], references: [id], onDelete: Restrict)

  @@unique([encounterActivityId, sequence])
  @@unique([encounterActivityId, code])
  @@index([encounterActivityId])
  @@map("encounter_activity_modifiers")
}

// A4.7 — one typed, non-executable structured billing fact recorded at Encounter scope or at the
// scope of one active EncounterActivity of the SAME Encounter. The value is exactly one of TEXT,
// DECIMAL (optionally with an opaque unit), BOOLEAN or DATE, enforced by database CHECKs — never a
// JSON bag, formula, operator or rule. Rows are append-and-remove facts: a correction marks the row
// removed and adds a NEW row. There is deliberately no organizationId/patient/provider/payer copy,
// no evidence, eligibility, authorization, claim or pricing field, and no sequence column.
model EncounterObservation {
  id                  String    @id @default(uuid()) @db.Uuid
  encounterId         String    @map("encounter_id") @db.Uuid
  encounterActivityId String?   @map("encounter_activity_id") @db.Uuid

  factKey             String    @map("fact_key") @db.Text
  valueType           String    @map("value_type") @db.Text

  valueText           String?   @map("value_text") @db.Text
  valueDecimal        Decimal?  @map("value_decimal") @db.Decimal(24, 8)
  valueBoolean        Boolean?  @map("value_boolean")
  valueDate           DateTime? @map("value_date") @db.Date
  unitCode            String?   @map("unit_code") @db.Text

  removedAt           DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  encounter           Encounter          @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  encounterActivity   EncounterActivity? @relation(fields: [encounterActivityId], references: [id], onDelete: Restrict)

  @@index([encounterId])
  @@index([encounterActivityId])
  @@index([encounterId, removedAt])
  @@index([factKey])
  @@map("encounter_observations")
}

model Facility {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  externalIdentifiers ExternalIdentifier[]
  regulatoryProfiles FacilityRegulatoryProfile[]
  contractFacilities ContractFacility[]
  ruleSourceScopes RuleSourceScope[]
  ruleApplicabilities RuleApplicability[]
  clinicianAssignments ClinicianFacilityAssignment[]
  encounters Encounter[]
  priorAuthorizations PriorAuthorization[]
  validationRuns ValidationRun[]


  @@index([organizationId])
  @@map("facilities")
}

model Clinician {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  facilityAssignments ClinicianFacilityAssignment[]
  specialtyAssignments ClinicianSpecialtyAssignment[]
  encounters Encounter[]
  priorAuthorizations PriorAuthorization[]


  @@index([organizationId])
  @@map("clinicians")
}

model Specialty {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  clinicianAssignments ClinicianSpecialtyAssignment[]

  @@index([organizationId])
  @@map("specialties")
}

// A4.2 — an effective-dated operational fact: this clinician practised at this facility between
// these dates. It is NOT credentialing, NOT a licence, and NOT commercial participation
// (ProviderContract -> ContractFacility owns that). There is deliberately no organizationId here:
// ownership comes from the Clinician and Facility masters and is checked to be equal on every
// write. There is no status flag either — currentness is derived from the period for a requested
// date, so a historical service date can always be answered.
model ClinicianFacilityAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  clinicianId   String    @map("clinician_id") @db.Uuid
  facilityId    String    @map("facility_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinician Clinician @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounters Encounter[]

  @@index([clinicianId])
  @@index([facilityId])
  @@index([clinicianId, facilityId])
  @@map("clinician_facility_assignments")
}

// A4.2 — the same effective-dated fact for a specialty. A clinician may practise several
// specialties at once, so there is deliberately no "primary" or "rank" field: A4.2 records what
// was assigned, not which one matters most.
model ClinicianSpecialtyAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  clinicianId   String    @map("clinician_id") @db.Uuid
  specialtyId   String    @map("specialty_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinician Clinician @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@index([clinicianId])
  @@index([specialtyId])
  @@index([clinicianId, specialtyId])
  @@map("clinician_specialty_assignments")
}

model Payer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  insuranceProducts InsuranceProduct[]
  ruleSourceScopes RuleSourceScope[]
  providerContracts ProviderContract[]
  insuranceMemberships InsuranceMembership[]
  eligibilityVerifications EligibilityVerification[]
  priorAuthorizations PriorAuthorization[]
  validationRuns ValidationRun[]


  @@index([organizationId])
  @@map("payers")
}

model Tpa {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  ruleSourceScopes RuleSourceScope[]
  providerContracts ProviderContract[]
  insuranceMemberships InsuranceMembership[]
  eligibilityVerifications EligibilityVerification[]
  priorAuthorizations PriorAuthorization[]
  validationRuns ValidationRun[]


  @@index([organizationId])
  @@map("tpas")
}

model Network {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  productNetworks ProductNetwork[]
  ruleSourceScopes RuleSourceScope[]
  providerContracts ProviderContract[]
  insuranceMemberships InsuranceMembership[]
  eligibilityVerifications EligibilityVerification[]
  priorAuthorizations PriorAuthorization[]
  validationRuns ValidationRun[]


  @@index([organizationId])
  @@map("networks")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  internalCode   String   @map("internal_code") @db.Text
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  tariffRates TariffRate[]
  encounterActivities EncounterActivity[]
  authorizationLines AuthorizationLine[]


  @@unique([organizationId, internalCode])
  @@index([organizationId])
  @@map("services")
}

model ProcedureCode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  internalCode   String   @map("internal_code") @db.Text
  displayName    String   @map("display_name") @db.Text
  codeSystem     String?  @map("code_system") @db.Text
  externalCode   String?  @map("external_code") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  tariffRates TariffRate[]
  encounterActivities EncounterActivity[]
  authorizationLines AuthorizationLine[]


  @@unique([organizationId, internalCode])
  @@index([organizationId])
  @@map("procedure_codes")
}

model DiagnosisCode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.Text
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  encounterDiagnoses EncounterDiagnosis[]
  authorizationLines AuthorizationLine[]


  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("diagnosis_codes")
}

model ExternalIdentifier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sourceSystem   String   @map("source_system") @db.Text
  externalValue  String   @map("external_value") @db.Text

  organizationTargetId String? @map("organization_target_id") @db.Uuid
  facilityId           String? @map("facility_id") @db.Uuid
  clinicianId          String? @map("clinician_id") @db.Uuid
  specialtyId          String? @map("specialty_id") @db.Uuid
  payerId              String? @map("payer_id") @db.Uuid
  tpaId                String? @map("tpa_id") @db.Uuid
  networkId            String? @map("network_id") @db.Uuid
  serviceId            String? @map("service_id") @db.Uuid
  procedureCodeId      String? @map("procedure_code_id") @db.Uuid
  diagnosisCodeId      String? @map("diagnosis_code_id") @db.Uuid
  patientId            String? @map("patient_id") @db.Uuid
  encounterId          String? @map("encounter_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization   @relation("ExternalIdentifierOwner", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationTarget Organization?  @relation("ExternalIdentifierOrganizationTarget", fields: [organizationTargetId], references: [id], onDelete: Restrict)
  facility           Facility?      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  clinician          Clinician?     @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  specialty          Specialty?     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  payer              Payer?         @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tpa                Tpa?           @relation(fields: [tpaId], references: [id], onDelete: Restrict)
  network            Network?       @relation(fields: [networkId], references: [id], onDelete: Restrict)
  service            Service?       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  procedureCode      ProcedureCode? @relation(fields: [procedureCodeId], references: [id], onDelete: Restrict)
  diagnosisCode      DiagnosisCode? @relation(fields: [diagnosisCodeId], references: [id], onDelete: Restrict)
  patient            Patient?       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter          Encounter?     @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceSystem, externalValue])
  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@map("external_identifiers")
}

model RuleSource {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String?  @map("organization_id") @db.Uuid
  jurisdictionCode String   @map("jurisdiction_code") @db.Text
  issuingAuthority String   @map("issuing_authority") @db.Text
  sourceCategory   String   @map("source_category") @db.Text
  referenceNumber  String   @map("reference_number") @db.Text
  title            String   @db.Text
  ownershipScope   String   @map("ownership_scope") @db.Text
