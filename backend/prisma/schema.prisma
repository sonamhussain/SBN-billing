generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  facilities  Facility[]
  memberships OrganizationMembership[]
  auditEvents AuditEvent[]
  clinicians  Clinician[]
  specialties Specialty[]
  payers      Payer[]
  tpas        Tpa[]
  networks    Network[]
  services    Service[]
  procedureCodes ProcedureCode[]
  diagnosisCodes DiagnosisCode[]
  externalIdentifiers       ExternalIdentifier[] @relation("ExternalIdentifierOwner")
  externalIdentifierTargets ExternalIdentifier[] @relation("ExternalIdentifierOrganizationTarget")
  ruleSources RuleSource[]
  ruleDefinitions RuleDefinition[]
  insuranceProducts InsuranceProduct[]
  providerContracts ProviderContract[]

  @@map("organizations")
}

model Facility {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  externalIdentifiers ExternalIdentifier[]
  regulatoryProfiles FacilityRegulatoryProfile[]
  contractFacilities ContractFacility[]
  ruleSourceScopes RuleSourceScope[]
  ruleApplicabilities RuleApplicability[]

  @@index([organizationId])
  @@map("facilities")
}

model Clinician {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]

  @@index([organizationId])
  @@map("clinicians")
}

model Specialty {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]

  @@index([organizationId])
  @@map("specialties")
}

model Payer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  insuranceProducts InsuranceProduct[]
  ruleSourceScopes RuleSourceScope[]

  @@index([organizationId])
  @@map("payers")
}

model Tpa {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  ruleSourceScopes RuleSourceScope[]

  @@index([organizationId])
  @@map("tpas")
}

model Network {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]
  productNetworks ProductNetwork[]
  ruleSourceScopes RuleSourceScope[]

  @@index([organizationId])
  @@map("networks")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  internalCode   String   @map("internal_code") @db.Text
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]

  @@unique([organizationId, internalCode])
  @@index([organizationId])
  @@map("services")
}

model ProcedureCode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  internalCode   String   @map("internal_code") @db.Text
  displayName    String   @map("display_name") @db.Text
  codeSystem     String?  @map("code_system") @db.Text
  externalCode   String?  @map("external_code") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]

  @@unique([organizationId, internalCode])
  @@index([organizationId])
  @@map("procedure_codes")
}

model DiagnosisCode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.Text
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalIdentifiers ExternalIdentifier[]
  ruleApplicabilities RuleApplicability[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("diagnosis_codes")
}

model ExternalIdentifier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sourceSystem   String   @map("source_system") @db.Text
  externalValue  String   @map("external_value") @db.Text

  organizationTargetId String? @map("organization_target_id") @db.Uuid
  facilityId           String? @map("facility_id") @db.Uuid
  clinicianId          String? @map("clinician_id") @db.Uuid
  specialtyId          String? @map("specialty_id") @db.Uuid
  payerId              String? @map("payer_id") @db.Uuid
  tpaId                String? @map("tpa_id") @db.Uuid
  networkId            String? @map("network_id") @db.Uuid
  serviceId            String? @map("service_id") @db.Uuid
  procedureCodeId      String? @map("procedure_code_id") @db.Uuid
  diagnosisCodeId      String? @map("diagnosis_code_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization   @relation("ExternalIdentifierOwner", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationTarget Organization?  @relation("ExternalIdentifierOrganizationTarget", fields: [organizationTargetId], references: [id], onDelete: Restrict)
  facility           Facility?      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  clinician          Clinician?     @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  specialty          Specialty?     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  payer              Payer?         @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tpa                Tpa?           @relation(fields: [tpaId], references: [id], onDelete: Restrict)
  network            Network?       @relation(fields: [networkId], references: [id], onDelete: Restrict)
  service            Service?       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  procedureCode      ProcedureCode? @relation(fields: [procedureCodeId], references: [id], onDelete: Restrict)
  diagnosisCode      DiagnosisCode? @relation(fields: [diagnosisCodeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceSystem, externalValue])
  @@index([organizationId])
  @@map("external_identifiers")
}

model RuleSource {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String?  @map("organization_id") @db.Uuid
  jurisdictionCode String   @map("jurisdiction_code") @db.Text
  issuingAuthority String   @map("issuing_authority") @db.Text
  sourceCategory   String   @map("source_category") @db.Text
  referenceNumber  String   @map("reference_number") @db.Text
  title            String   @db.Text
  ownershipScope   String   @map("ownership_scope") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     RuleSourceVersion[]
  scopes       RuleSourceScope[]

  @@index([organizationId])
  @@index([jurisdictionCode])
  @@index([sourceCategory])
  @@map("rule_sources")
}

model RuleSourceVersion {
  id             String   @id @default(uuid()) @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  version        String   @db.Text
  rawEvidenceRef String   @map("raw_evidence_ref") @db.Text

  publicationStatus String    @default("DRAFT") @map("publication_status") @db.Text
  publicationDate   DateTime? @map("publication_date") @db.Date

  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  verificationStatus String    @default("UNVERIFIED") @map("verification_status") @db.Text
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)

  activationStatus   String    @default("INACTIVE") @map("activation_status") @db.Text
  activationBlockers String[]  @default([]) @map("activation_blockers")
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(6)
  suspendedAt        DateTime? @map("suspended_at") @db.Timestamptz(6)
  supersededAt       DateTime? @map("superseded_at") @db.Timestamptz(6)
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  source          RuleSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  interpretations SourceInterpretation[]

  outgoingRelationships RuleSourceRelationship[] @relation("SourceRelationshipFrom")
  incomingRelationships RuleSourceRelationship[] @relation("SourceRelationshipTo")
  referenceDatasetVersions ReferenceDatasetVersion[]

  @@unique([sourceId, version])
  @@index([sourceId])
  @@map("rule_source_versions")
}

model RuleSourceRelationship {
  id                  String   @id @default(uuid()) @db.Uuid
  fromSourceVersionId String   @map("from_source_version_id") @db.Uuid
  toSourceVersionId   String   @map("to_source_version_id") @db.Uuid
  relationshipType    String   @map("relationship_type") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fromSourceVersion RuleSourceVersion @relation("SourceRelationshipFrom", fields: [fromSourceVersionId], references: [id], onDelete: Restrict)
  toSourceVersion   RuleSourceVersion @relation("SourceRelationshipTo", fields: [toSourceVersionId], references: [id], onDelete: Restrict)

  @@unique([fromSourceVersionId, toSourceVersionId, relationshipType])
  @@index([fromSourceVersionId])
  @@index([toSourceVersionId])
  @@index([relationshipType])
  @@map("rule_source_relationships")
}

model SourceInterpretation {
  id                          String    @id @default(uuid()) @db.Uuid
  sourceVersionId             String    @map("source_version_id") @db.Uuid
  interpretationVersion       String    @map("interpretation_version") @db.Text
  normalizedInterpretationRef String    @map("normalized_interpretation_ref") @db.Text
  verificationStatus          String    @map("verification_status") @db.Text
  verifiedAt                  DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceVersion RuleSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  bindings      RuleSourceBinding[]

  @@unique([sourceVersionId, interpretationVersion])
  @@index([sourceVersionId])
  @@map("source_interpretations")
}

model RuleDefinition {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String?  @map("organization_id") @db.Uuid
  ruleKey          String   @map("rule_key") @db.Text
  displayName      String   @map("display_name") @db.Text
  jurisdictionCode String   @map("jurisdiction_code") @db.Text
  ownershipScope   String   @map("ownership_scope") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     RuleVersion[]

  @@index([organizationId])
  @@index([jurisdictionCode])
  @@map("rule_definitions")
}

model RuleVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  ruleId             String    @map("rule_id") @db.Uuid
  version            String    @db.Text
  effectType         String    @map("effect_type") @db.Text
  effectiveFrom      DateTime? @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  verificationStatus String    @default("UNVERIFIED") @map("verification_status") @db.Text
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  rule RuleDefinition @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  applicabilities RuleApplicability[]
  sourceBindings  RuleSourceBinding[]

  @@unique([ruleId, version])
  @@index([ruleId])
  @@index([effectType])
  @@map("rule_versions")
}

model RuleApplicability {
  id                        String   @id @default(uuid()) @db.Uuid
  ruleVersionId             String   @map("rule_version_id") @db.Uuid
  facilityId                String?  @map("facility_id") @db.Uuid
  facilityRegulatoryProfileId String? @map("facility_regulatory_profile_id") @db.Uuid
  payerId                   String?  @map("payer_id") @db.Uuid
  tpaId                     String?  @map("tpa_id") @db.Uuid
  networkId                 String?  @map("network_id") @db.Uuid
  insuranceProductId        String?  @map("insurance_product_id") @db.Uuid
  providerContractId        String?  @map("provider_contract_id") @db.Uuid
  tariffScheduleId          String?  @map("tariff_schedule_id") @db.Uuid
  tariffScheduleVersionId   String?  @map("tariff_schedule_version_id") @db.Uuid
  serviceId                 String?  @map("service_id") @db.Uuid
  procedureCodeId           String?  @map("procedure_code_id") @db.Uuid
  diagnosisCodeId           String?  @map("diagnosis_code_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ruleVersion             RuleVersion                @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  facility                Facility?                  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  facilityRegulatoryProfile FacilityRegulatoryProfile? @relation(fields: [facilityRegulatoryProfileId], references: [id], onDelete: Restrict)
  payer                   Payer?                     @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tpa                     Tpa?                       @relation(fields: [tpaId], references: [id], onDelete: Restrict)
  network                 Network?                   @relation(fields: [networkId], references: [id], onDelete: Restrict)
  insuranceProduct        InsuranceProduct?          @relation(fields: [insuranceProductId], references: [id], onDelete: Restrict)
  providerContract        ProviderContract?          @relation(fields: [providerContractId], references: [id], onDelete: Restrict)
  tariffSchedule          TariffSchedule?            @relation(fields: [tariffScheduleId], references: [id], onDelete: Restrict)
  tariffScheduleVersion   TariffScheduleVersion?     @relation(fields: [tariffScheduleVersionId], references: [id], onDelete: Restrict)
  service                 Service?                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  procedureCode           ProcedureCode?             @relation(fields: [procedureCodeId], references: [id], onDelete: Restrict)
  diagnosisCode           DiagnosisCode?             @relation(fields: [diagnosisCodeId], references: [id], onDelete: Restrict)

  @@index([ruleVersionId])
  @@index([facilityId])
  @@index([facilityRegulatoryProfileId])
  @@index([payerId])
  @@index([tpaId])
  @@index([networkId])
  @@index([insuranceProductId])
  @@index([providerContractId])
  @@index([tariffScheduleId])
  @@index([tariffScheduleVersionId])
  @@index([serviceId])
  @@index([procedureCodeId])
  @@index([diagnosisCodeId])
  @@map("rule_applicabilities")
}

model RuleSourceBinding {
  id                     String   @id @default(uuid()) @db.Uuid
  ruleVersionId          String   @map("rule_version_id") @db.Uuid
  sourceInterpretationId String   @map("source_interpretation_id") @db.Uuid
  sourceRole             String   @map("source_role") @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ruleVersion          RuleVersion          @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  sourceInterpretation SourceInterpretation @relation(fields: [sourceInterpretationId], references: [id], onDelete: Restrict)

  @@unique([ruleVersionId, sourceInterpretationId])
  @@index([ruleVersionId])
  @@index([sourceInterpretationId])
  @@index([sourceRole])
  @@map("rule_source_bindings")
}

// REF-01 / R1 — Facility Regulatory Context

model FacilityRegulatoryProfile {
  id                      String    @id @default(uuid()) @db.Uuid
  facilityId              String    @map("facility_id") @db.Uuid
  jurisdictionCode        String    @map("jurisdiction_code") @db.Text
  regulatoryAuthorityCode String    @map("regulatory_authority_code") @db.Text
  effectiveFrom           DateTime  @map("effective_from") @db.Date
  effectiveTo             DateTime? @map("effective_to") @db.Date
  status                  String    @db.Text
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  ruleApplicabilities RuleApplicability[]

  @@index([facilityId])
  @@index([status])
  @@map("facility_regulatory_profiles")
}

// REF-01 / R2 — Commercial Coverage Identity Foundation

model InsuranceProduct {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  payerId        String   @map("payer_id") @db.Uuid
  productCode    String   @map("product_code") @db.Text
  displayName    String   @map("display_name") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payer              Payer              @relation(fields: [payerId], references: [id], onDelete: Restrict)
  productNetworks    ProductNetwork[]
  providerContracts  ProviderContract[]
  ruleSourceScopes   RuleSourceScope[]
  ruleApplicabilities RuleApplicability[]

  @@unique([organizationId, productCode])
  @@index([organizationId])
  @@index([payerId])
  @@map("insurance_products")
}

model ProductNetwork {
  id                 String   @id @default(uuid()) @db.Uuid
  insuranceProductId String   @map("insurance_product_id") @db.Uuid
  networkId          String   @map("network_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  insuranceProduct  InsuranceProduct   @relation(fields: [insuranceProductId], references: [id], onDelete: Restrict)
  network           Network            @relation(fields: [networkId], references: [id], onDelete: Restrict)
  providerContracts ProviderContract[]

  @@unique([insuranceProductId, networkId])
  @@index([insuranceProductId])
  @@index([networkId])
  @@map("product_networks")
}

model ProviderContract {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  insuranceProductId String?  @map("insurance_product_id") @db.Uuid
  productNetworkId   String?  @map("product_network_id") @db.Uuid
  contractKey        String   @map("contract_key") @db.Text
  displayName        String   @map("display_name") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  insuranceProduct   InsuranceProduct?  @relation(fields: [insuranceProductId], references: [id], onDelete: Restrict)
  productNetwork     ProductNetwork?    @relation(fields: [productNetworkId], references: [id], onDelete: Restrict)
  contractFacilities ContractFacility[]
  tariffSchedules    TariffSchedule[]
  ruleSourceScopes   RuleSourceScope[]
  ruleApplicabilities RuleApplicability[]

  @@unique([organizationId, contractKey])
  @@index([organizationId])
  @@index([insuranceProductId])
  @@index([productNetworkId])
  @@map("provider_contracts")
}

model ContractFacility {
  id                 String   @id @default(uuid()) @db.Uuid
  providerContractId String   @map("provider_contract_id") @db.Uuid
  facilityId         String   @map("facility_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  providerContract ProviderContract @relation(fields: [providerContractId], references: [id], onDelete: Restrict)
  facility         Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([providerContractId, facilityId])
  @@index([providerContractId])
  @@index([facilityId])
  @@map("contract_facilities")
}

model TariffSchedule {
  id                 String   @id @default(uuid()) @db.Uuid
  providerContractId String   @map("provider_contract_id") @db.Uuid
  tariffKey          String   @map("tariff_key") @db.Text
  displayName        String   @map("display_name") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  providerContract ProviderContract        @relation(fields: [providerContractId], references: [id], onDelete: Restrict)
  versions         TariffScheduleVersion[]
  ruleSourceScopes RuleSourceScope[]
  ruleApplicabilities RuleApplicability[]

  @@unique([providerContractId, tariffKey])
  @@index([providerContractId])
  @@map("tariff_schedules")
}

model TariffScheduleVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  tariffScheduleId   String    @map("tariff_schedule_id") @db.Uuid
  version            String    @db.Text
  effectiveFrom      DateTime? @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  verificationStatus String    @default("UNVERIFIED") @map("verification_status") @db.Text
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tariffSchedule   TariffSchedule    @relation(fields: [tariffScheduleId], references: [id], onDelete: Restrict)
  ruleSourceScopes RuleSourceScope[]
  ruleApplicabilities RuleApplicability[]

  @@unique([tariffScheduleId, version])
  @@index([tariffScheduleId])
  @@map("tariff_schedule_versions")
}

// REF-01 / R3 — Regulatory Reference Dataset Registry

model ReferenceDataset {
  id               String   @id @default(uuid()) @db.Uuid
  datasetKey       String   @map("dataset_key") @db.Text
  displayName      String   @map("display_name") @db.Text
  jurisdictionCode String   @map("jurisdiction_code") @db.Text
  authorityCode    String   @map("authority_code") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions ReferenceDatasetVersion[]

  @@unique([datasetKey])
  @@index([jurisdictionCode])
  @@map("reference_datasets")
}

model ReferenceDatasetVersion {
  id               String    @id @default(uuid()) @db.Uuid
  datasetId        String    @map("dataset_id") @db.Uuid
  sourceVersionId  String?   @map("source_version_id") @db.Uuid
  version          String    @db.Text
  retrievedAt      DateTime  @map("retrieved_at") @db.Timestamptz(6)
  publicationDate  DateTime? @map("publication_date") @db.Date
  effectiveFrom    DateTime? @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  contentHash      String    @map("content_hash") @db.Text
  validationStatus String    @map("validation_status") @db.Text
  activationStatus String    @map("activation_status") @db.Text
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(6)
  supersededAt     DateTime? @map("superseded_at") @db.Timestamptz(6)
  retiredAt        DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  dataset       ReferenceDataset   @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  sourceVersion RuleSourceVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)

  @@unique([datasetId, version])
  @@index([datasetId])
  @@index([sourceVersionId])
  @@map("reference_dataset_versions")
}

// REF-01 / R4 — RuleSourceScope: typed commercial context proof

model RuleSourceScope {
  id                      String   @id @default(uuid()) @db.Uuid
  sourceId                String   @map("source_id") @db.Uuid
  facilityId              String?  @map("facility_id") @db.Uuid
  payerId                 String?  @map("payer_id") @db.Uuid
  tpaId                   String?  @map("tpa_id") @db.Uuid
  networkId               String?  @map("network_id") @db.Uuid
  insuranceProductId      String?  @map("insurance_product_id") @db.Uuid
  providerContractId      String?  @map("provider_contract_id") @db.Uuid
  tariffScheduleId        String?  @map("tariff_schedule_id") @db.Uuid
  tariffScheduleVersionId String?  @map("tariff_schedule_version_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  source                 RuleSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  facility               Facility?              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  payer                  Payer?                 @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tpa                    Tpa?                   @relation(fields: [tpaId], references: [id], onDelete: Restrict)
  network                Network?               @relation(fields: [networkId], references: [id], onDelete: Restrict)
  insuranceProduct       InsuranceProduct?      @relation(fields: [insuranceProductId], references: [id], onDelete: Restrict)
  providerContract       ProviderContract?      @relation(fields: [providerContractId], references: [id], onDelete: Restrict)
  tariffSchedule         TariffSchedule?        @relation(fields: [tariffScheduleId], references: [id], onDelete: Restrict)
  tariffScheduleVersion  TariffScheduleVersion? @relation(fields: [tariffScheduleVersionId], references: [id], onDelete: Restrict)

  @@index([sourceId])
  @@index([facilityId])
  @@index([payerId])
  @@index([tpaId])
  @@index([networkId])
  @@index([insuranceProductId])
  @@index([providerContractId])
  @@index([tariffScheduleId])
  @@index([tariffScheduleVersionId])
  @@map("rule_source_scopes")
}

model User {
  id            String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   OrganizationMembership[]
  auditEvents   AuditEvent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.Text
  name        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships MembershipRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.Text
  name  String @db.Text
  roles RolePermission[]

  @@map("permissions")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  actionCode     String   @map("action_code") @db.Text
  entityType     String   @map("entity_type") @db.Text
  entityId       String   @map("entity_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  beforeState    Json?    @map("before_state") @db.JsonB
  afterState     Json?    @map("after_state") @db.JsonB

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}
