  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.Text
  name        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships MembershipRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.Text
  name  String @db.Text
  roles RolePermission[]

  @@map("permissions")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  actionCode     String   @map("action_code") @db.Text
  entityType     String   @map("entity_type") @db.Text
  entityId       String   @map("entity_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  beforeState    Json?    @map("before_state") @db.JsonB
  afterState     Json?    @map("after_state") @db.JsonB

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}

// A3.9 — Rule Pack Version & Provenance Contract. A RulePack groups exact RuleVersions into
// versioned, governed snapshots. Membership is an exact RuleVersion UUID and nothing else: no
// applicability, context, source or commercial copies (A3.6/A3.7 remain their only owners).
// Ownership, one-ACTIVE and pack-key scope rules are enforced by hand-written SQL in the A3.9
// migration because Prisma's DSL cannot express them.

model RulePack {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String?  @map("organization_id") @db.Uuid
  packKey          String   @map("pack_key") @db.Text
  displayName      String   @map("display_name") @db.Text
  jurisdictionCode String   @map("jurisdiction_code") @db.Text
  ownershipScope   String   @map("ownership_scope") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     RulePackVersion[]

  @@index([organizationId])
  @@index([jurisdictionCode])
  @@map("rule_packs")
}

model RulePackVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  rulePackId         String    @map("rule_pack_id") @db.Uuid
  version            String    @db.Text
  effectiveFrom      DateTime? @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  verificationStatus String    @default("UNVERIFIED") @map("verification_status") @db.Text
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  activationStatus   String    @default("INACTIVE") @map("activation_status") @db.Text
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(6)
  supersededAt       DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  rulePack RulePack         @relation(fields: [rulePackId], references: [id], onDelete: Restrict)
  members  RulePackMember[]
  validationFindingRuleProvenances ValidationFindingRuleProvenance[]

  @@unique([rulePackId, version])
  @@index([rulePackId])
  @@index([verificationStatus])
  @@index([activationStatus])
  @@map("rule_pack_versions")
}

model RulePackMember {
  id                String   @id @default(uuid()) @db.Uuid
  rulePackVersionId String   @map("rule_pack_version_id") @db.Uuid
  ruleVersionId     String   @map("rule_version_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rulePackVersion RulePackVersion @relation(fields: [rulePackVersionId], references: [id], onDelete: Restrict)
  ruleVersion     RuleVersion     @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@unique([rulePackVersionId, ruleVersionId])
  @@index([rulePackVersionId])
  @@index([ruleVersionId])
  @@map("rule_pack_members")
}


// A5.1 - EvidenceArtifact answers "what stable evidence identity is this?" and
// EvidenceArtifactVersion answers "which exact representation was received and stored?".
//
// The artifact carries no document content and no workflow status: it is only a durable handle that
// later A5 records and, eventually, an A6 ClaimSubmission can point at. Everything that describes a
// particular received representation lives on a version, and a version is append-only - a
// correction or replacement is a NEW version, never an edit of an earlier one, so evidence a
// decision was made against can still be read exactly as it was.
//
// A5.1 deliberately carries no patient, encounter, membership, eligibility, authorization or claim
// reference. Those relationships belong to the records that own them, and putting them here would
// make this table the second home for workflow truth it does not own.

model EvidenceArtifact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     EvidenceArtifactVersion[]

  @@index([organizationId])
  @@map("evidence_artifacts")
}

model EvidenceArtifactVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  evidenceArtifactId String    @map("evidence_artifact_id") @db.Uuid
  // Server-owned and gap-free per artifact; a client never supplies it.
  version            Int
  // An opaque locator for evidence stored elsewhere. It is never parsed as a path, URL, bucket key
  // or vendor object id, and it never appears in an audit record or a log.
  storageRef         String    @map("storage_ref") @db.Text
  // A canonical lowercase SHA-256 digest. It proves byte identity of the stored representation; it
  // is not a signature, an authenticity proof or an authorization decision.
  contentHash        String    @map("content_hash") @db.Text
  // Opaque. No payer or UAE vocabulary is assumed or enforced here.
  documentType       String    @map("document_type") @db.Text
  // Null means the source date is unknown. It is never inferred from receivedAt.
  sourceDate         DateTime? @map("source_date") @db.Date
  receivedAt         DateTime  @map("received_at") @db.Timestamptz(6)
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  evidenceArtifact EvidenceArtifact @relation(fields: [evidenceArtifactId], references: [id], onDelete: Restrict)
  createdBy        User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  // A5.2 references a version as request or response proof. Two named relations are required
  // because both point at this same model. A5.2 stores only these foreign keys: no evidence
  // metadata is copied, and nothing here becomes mutable.
  eligibilityRequestUses  EligibilityVerification[] @relation("EligibilityRequestEvidence")
  eligibilityResponseUses EligibilityVerification[] @relation("EligibilityResponseEvidence")

  // There is deliberately no unique index on contentHash or storageRef: the same bytes may
  // legitimately back more than one evidence identity, and storage-provider identity semantics are
  // not frozen by this package.
  priorAuthorizationEvidenceLinks PriorAuthorizationVersionEvidence[]

  encounterEvidenceLinks EncounterEvidenceLink[]
  validationFindings ValidationFinding[]
  @@unique([evidenceArtifactId, version])
  @@index([evidenceArtifactId])
  @@index([createdByUserId])
  @@index([documentType])
  @@index([contentHash])
  @@map("evidence_artifact_versions")
}

// A5.2 — an immutable, evidence-bearing eligibility verification.
//
// It records what a verification actually REPORTED, not what registration implies. A4.3 answers
// registration truth; this answers verification truth, and the two are never equated: a recorded
// coverage period that contains the service date is not eligibility, and a missing or failed
// response is UNKNOWN, never INELIGIBLE.
//
// A verification is a historical event. Re-verifying creates a NEW row; the earlier one is never
// rewritten, which a database trigger enforces alongside the absent PATCH and DELETE routes.
//
// Freshness is DERIVED at read time from validThrough and is deliberately not a column here. A
// stored freshness flag would go stale the moment the clock moved past it, and FRESH would begin to
// read as ELIGIBLE, which it never means.
model EligibilityVerification {
  id                    String @id @default(uuid()) @db.Uuid
  encounterId           String @map("encounter_id") @db.Uuid
  insuranceMembershipId String @map("insurance_membership_id") @db.Uuid

  // The commercial context exactly as it stood on the selected membership at verification time, and
  // the Encounter's service date as it stood then. These are historical decision context, not a
  // second membership record: a later correction to the membership or the Encounter must not be
  // able to rewrite what this verification was evaluated against.
  payerId            String   @map("payer_id") @db.Uuid
  tpaId              String?  @map("tpa_id") @db.Uuid
  networkId          String?  @map("network_id") @db.Uuid
  insuranceProductId String?  @map("insurance_product_id") @db.Uuid
  serviceDate        DateTime @map("service_date") @db.Date

  // ELECTRONIC | PORTAL | MANUAL | OTHER. ELECTRONIC records how the result was obtained; it does
  // not imply that a production payer adapter exists. That transport belongs to A9.
  verificationMethod String    @map("verification_method") @db.Text
  // ELIGIBLE | INELIGIBLE | UNKNOWN, as reported by the source. UNKNOWN is a first-class answer and
  // is never optimistically resolved.
  status             String    @db.Text
  // Null when genuinely unknown; never inferred from createdAt.
  requestedAt        DateTime? @map("requested_at") @db.Timestamptz(6)
  respondedAt        DateTime  @map("responded_at") @db.Timestamptz(6)
  // The recorded validity boundary. Null means no normalized boundary is known, which makes
  // freshness UNKNOWN rather than fresh or stale. It is never inferred from coverageTo or from a
  // hard-coded payer duration.
  validThrough       DateTime? @map("valid_through") @db.Timestamptz(6)

  // Normalized requirement indicators, recorded only when the response explicitly supplied them.
  // Null means not supplied, which is not the same as false.
  authorizationRequired Boolean? @map("authorization_required")
  referralRequired      Boolean? @map("referral_required")

  // Exact A5.1 proof. The response is mandatory — a verification without evidence is not an A5.2
  // verification. The request is optional because a portal or manual workflow may preserve only the
  // response. No storage reference, hash or document type is copied here; A5.1 owns all of that.
  requestEvidenceVersionId  String?  @map("request_evidence_version_id") @db.Uuid
  responseEvidenceVersionId String   @map("response_evidence_version_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  encounter               Encounter                @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  insuranceMembership     InsuranceMembership      @relation(fields: [insuranceMembershipId], references: [id], onDelete: Restrict)
  payer                   Payer                    @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tpa                     Tpa?                     @relation(fields: [tpaId], references: [id], onDelete: Restrict)
  network                 Network?                 @relation(fields: [networkId], references: [id], onDelete: Restrict)
  insuranceProduct        InsuranceProduct?        @relation(fields: [insuranceProductId], references: [id], onDelete: Restrict)
  requestEvidenceVersion  EvidenceArtifactVersion? @relation("EligibilityRequestEvidence", fields: [requestEvidenceVersionId], references: [id], onDelete: Restrict)
  responseEvidenceVersion EvidenceArtifactVersion  @relation("EligibilityResponseEvidence", fields: [responseEvidenceVersionId], references: [id], onDelete: Restrict)

  // There is deliberately no unique index on encounterId or responseEvidenceVersionId: repeated
  // verification of one encounter is legitimate, and one external response may support more than one
  // encounter or context. There is no isCurrent or isPrimary flag either — choosing which
  // verification is usable belongs to a later governed consumer, not to this table.
  priorAuthorizationVersions PriorAuthorizationVersion[]
  validationFindings ValidationFinding[]

  @@index([encounterId])
  @@index([insuranceMembershipId])
  @@index([payerId])
  @@index([responseEvidenceVersionId])
  @@index([respondedAt])
  @@index([validThrough])
  @@map("eligibility_verifications")
}

// A5.3 — the authorization case: which authorization this is, for this exact Encounter context.
// The context is frozen at creation. If the Encounter later moves to a different membership,
// facility or clinician, that is a NEW authorization case, never a rewrite of this one.
model PriorAuthorization {
  id                    String   @id @default(uuid()) @db.Uuid
  encounterId           String   @map("encounter_id") @db.Uuid
  insuranceMembershipId String   @map("insurance_membership_id") @db.Uuid
  payerId               String   @map("payer_id") @db.Uuid
  tpaId                 String?  @map("tpa_id") @db.Uuid
  networkId             String?  @map("network_id") @db.Uuid
  insuranceProductId    String?  @map("insurance_product_id") @db.Uuid
  facilityId            String   @map("facility_id") @db.Uuid
  clinicianId           String   @map("clinician_id") @db.Uuid
  serviceDate           DateTime @map("service_date") @db.Date
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  encounter           Encounter           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  insuranceMembership InsuranceMembership @relation(fields: [insuranceMembershipId], references: [id], onDelete: Restrict)
  payer               Payer               @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tpa                 Tpa?                @relation(fields: [tpaId], references: [id], onDelete: Restrict)
  network             Network?            @relation(fields: [networkId], references: [id], onDelete: Restrict)
  insuranceProduct    InsuranceProduct?   @relation(fields: [insuranceProductId], references: [id], onDelete: Restrict)
  facility            Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  clinician           Clinician           @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  versions            PriorAuthorizationVersion[]

  // No unique index on encounterId: more than one authorization case per Encounter is legitimate.
  // No current-version pointer either — choosing a usable version belongs to A5.4 and A5.8.
  @@index([encounterId])
  @@index([insuranceMembershipId])
  @@index([payerId])
  @@index([facilityId])
  @@index([clinicianId])
  @@map("prior_authorizations")
}

// A5.3 — one immutable lifecycle snapshot. A later payer response, amendment or extension is a NEW
// version; nothing here is ever patched. Every version is complete: it inherits nothing from the
// version before it.
model PriorAuthorizationVersion {
  id                   String @id @default(uuid()) @db.Uuid
  priorAuthorizationId String @map("prior_authorization_id") @db.Uuid
  // Server-owned and gap-free per authorization; a client never supplies it.
  version              Int
  // INITIAL | RESPONSE | AMENDMENT | EXTENSION | CORRECTION — why this snapshot exists.
  versionKind          String @map("version_kind") @db.Text
  // REQUESTED | PENDING | APPROVED | PARTIALLY_APPROVED | DENIED | UNKNOWN — what the source
  // reported. UNKNOWN is first-class and is never resolved into approval.
  status               String @db.Text
  // An opaque payer or portal reference. Deliberately not unique: payer semantics are external and
  // a reference may be absent or reused.
  authorizationReference    String?   @map("authorization_reference") @db.Text
  // Optional provenance only. Linking an eligibility verification never makes eligibility an input
  // to the authorization result.
  eligibilityVerificationId String?   @map("eligibility_verification_id") @db.Uuid
  requestedAt               DateTime? @map("requested_at") @db.Timestamptz(6)
  respondedAt               DateTime? @map("responded_at") @db.Timestamptz(6)
  // Validity is these two dates and nothing else. There is no EXPIRED or ACTIVE status: whether an
  // authorization applies to a claim context is decided by A5.4 and A5.8.
  validFrom                 DateTime? @map("valid_from") @db.Date
  validThrough              DateTime? @map("valid_through") @db.Date
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  priorAuthorization      PriorAuthorization       @relation(fields: [priorAuthorizationId], references: [id], onDelete: Restrict)
  eligibilityVerification EligibilityVerification? @relation(fields: [eligibilityVerificationId], references: [id], onDelete: Restrict)
  createdBy               User                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  evidenceLinks           PriorAuthorizationVersionEvidence[]
  authorizationLines AuthorizationLine[]
  validationFindings ValidationFinding[]


  @@unique([priorAuthorizationId, version])
  @@index([priorAuthorizationId])
  @@index([eligibilityVerificationId])
  @@index([status])
  @@index([validThrough])
  @@map("prior_authorization_versions")
}

// A5.3 — which exact A5.1 evidence backs this version, and in what role. The role is REQUEST,
// RESPONSE or SUPPORTING; it is not a document type, and no payer document vocabulary is assumed.
// No storage reference, hash or document metadata is copied here: A5.1 owns all of it.
model PriorAuthorizationVersionEvidence {
  id                          String   @id @default(uuid()) @db.Uuid
  priorAuthorizationVersionId String   @map("prior_authorization_version_id") @db.Uuid
  evidenceArtifactVersionId   String   @map("evidence_artifact_version_id") @db.Uuid
  role                        String   @db.Text
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  priorAuthorizationVersion PriorAuthorizationVersion @relation(fields: [priorAuthorizationVersionId], references: [id], onDelete: Restrict)
  evidenceArtifactVersion   EvidenceArtifactVersion   @relation(fields: [evidenceArtifactVersionId], references: [id], onDelete: Restrict)

  @@unique([priorAuthorizationVersionId, evidenceArtifactVersionId, role])
  @@index([priorAuthorizationVersionId])
  @@index([evidenceArtifactVersionId])
  @@map("prior_authorization_version_evidence")
}

// A5.4 — one line of line-level authorization scope, as reported for one exact A5.3 version.
//
// A line belongs to an immutable PriorAuthorizationVersion, never to the stable PriorAuthorization:
// a payer amendment or correction is a new A5.3 version with a new line set, so earlier scope is
// never rewritten and the history of what was authorized when stays reconstructable.
//
// Nothing here is derived. The status is what the source reported, not something inferred from the
// quantities or from the header; a header and its lines that disagree are preserved as reported, and
// that disagreement is for A5.8 to judge. There is deliberately no activity, claim-line, match,
// consumed-quantity or readiness column: matching is computed, read-only, every time it is asked for,
// so it can never go stale against the Encounter it describes.
model AuthorizationLine {
  id                          String @id @default(uuid()) @db.Uuid
  priorAuthorizationVersionId String @map("prior_authorization_version_id") @db.Uuid
  // Server-owned, 1..N in the order the batch was submitted. It is display and source order only —
  // never precedence. Two lines that both fit an activity are AMBIGUOUS, whatever their sequence.
  sequence                    Int

  // The authorized identity. At least one of service and procedure is required; when both are present
  // an activity must match both. No Service-to-Procedure mapping is assumed between them.
  serviceId       String? @map("service_id") @db.Uuid
  procedureCodeId String? @map("procedure_code_id") @db.Uuid
  // Optional scope by code identity. It is not an activity-to-diagnosis relationship and never becomes
  // a claim-line diagnosis pointer.
  diagnosisCodeId String? @map("diagnosis_code_id") @db.Uuid

  // Exact NUMERIC, never binary floating point. requestedQty is recorded source truth; approvedQty is
  // the approval capacity when the source supplied one, and null means it did not. approvedQty is not
  // required to be at most requestedQty: payer semantics are external and are preserved as reported.
  requestedQty Decimal  @map("requested_qty") @db.Decimal(18, 4)
  approvedQty  Decimal? @map("approved_qty") @db.Decimal(18, 4)
  // Optional and opaque, case preserved. It exists only so quantities in explicitly different units
  // are never added together or compared.
  unitCode     String?  @map("unit_code") @db.Text

  // Optional line-level date bounds. A missing side contributes no restriction; nothing is invented.
  approvedFrom    DateTime? @map("approved_from") @db.Date
  approvedThrough DateTime? @map("approved_through") @db.Date
  // REQUESTED | PENDING | APPROVED | PARTIALLY_APPROVED | DENIED | UNKNOWN, exactly as reported.
  status          String    @db.Text

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  priorAuthorizationVersion PriorAuthorizationVersion @relation(fields: [priorAuthorizationVersionId], references: [id], onDelete: Restrict)
  service                   Service?                  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  procedureCode             ProcedureCode?            @relation(fields: [procedureCodeId], references: [id], onDelete: Restrict)
  diagnosisCode             DiagnosisCode?            @relation(fields: [diagnosisCodeId], references: [id], onDelete: Restrict)
  createdBy                 User                      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  // No uniqueness on the service, procedure or diagnosis combination: a payer may legitimately report
  // the same scope on more than one line. No current, primary or winner column either.
  validationFindings ValidationFinding[]
  @@unique([priorAuthorizationVersionId, sequence])
  @@index([priorAuthorizationVersionId])
  @@index([serviceId])
  @@index([procedureCodeId])
  @@index([diagnosisCodeId])
  @@index([status])
  @@map("authorization_lines")
}

// A5.6 — the typed payload of one DOCUMENTATION_REQUIREMENT_EFFECT RuleVersion. A3 owns the rule's
// identity, applicability, sources, precedence and provenance; this row owns only what evidence the
// governed rule asks for. It is attached once, while the RuleVersion is UNVERIFIED, and never
// edited: correcting it means a new RuleVersion. There is deliberately no payer, TPA, network,
// product, contract, tariff, service, procedure, diagnosis or jurisdiction column here — scope is
// A3 RuleApplicability's.
model EvidenceRequirement {
  id                 String   @id @default(uuid()) @db.Uuid
  ruleVersionId      String   @unique @map("rule_version_id") @db.Uuid
  minimumCount       Int      @default(1) @map("minimum_count")
  sourceDateRequired Boolean  @default(false) @map("source_date_required")
  maxSourceAgeDays   Int?     @map("max_source_age_days")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ruleVersion   RuleVersion                       @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  documentTypes EvidenceRequirementDocumentType[]
  validationFindings ValidationFinding[]

  @@index([ruleVersionId])
  @@map("evidence_requirements")
}

// A5.6 — the accepted document types of one requirement. Several types are alternatives for that one
// requirement; two independent documents are two governed rules, never a hidden AND list.
model EvidenceRequirementDocumentType {
  id                    String   @id @default(uuid()) @db.Uuid
  evidenceRequirementId String   @map("evidence_requirement_id") @db.Uuid
  documentType          String   @map("document_type") @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  evidenceRequirement EvidenceRequirement @relation(fields: [evidenceRequirementId], references: [id], onDelete: Restrict)

  @@unique([evidenceRequirementId, documentType])
  @@index([evidenceRequirementId])
  @@map("evidence_requirement_document_types")
}

// A5.6 — one exact A5.1 evidence version associated with an Encounter, where no narrower owner (A5.2
// eligibility, A5.3 authorization) already links it. Nothing about the evidence is copied. A link is
// removed once by setting removedAt and is never deleted or reactivated; re-linking is a new row.
model EncounterEvidenceLink {
  id                        String    @id @default(uuid()) @db.Uuid
  encounterId               String    @map("encounter_id") @db.Uuid
  evidenceArtifactVersionId String    @map("evidence_artifact_version_id") @db.Uuid
  removedAt                 DateTime? @map("removed_at") @db.Timestamptz(6)
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  encounter               Encounter               @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  evidenceArtifactVersion EvidenceArtifactVersion @relation(fields: [evidenceArtifactVersionId], references: [id], onDelete: Restrict)
  createdBy               User                    @relation("EncounterEvidenceLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([encounterId])
  @@index([evidenceArtifactVersionId])
  @@index([encounterId, removedAt])
  @@map("encounter_evidence_links")
}

// A5.7 — one complete, immutable pre-claim validation run: the exact server-owned context a
// deterministic validator evaluated, when (the database transaction instant), and by which validator
// contract version. There is no status, no current/latest pointer and no overall outcome: a later
// validation is another run, and A5.9 owns readiness. Ownership derives from Encounter -> Patient.
// Membership and commercial context are nullable so a run can record that they were absent or
// unresolved; null never means "valid".
model ValidationRun {
  id                          String   @id @default(uuid()) @db.Uuid
  encounterId                 String   @map("encounter_id") @db.Uuid
  serviceDate                 DateTime @map("service_date") @db.Date
  facilityId                  String   @map("facility_id") @db.Uuid
  facilityRegulatoryProfileId String   @map("facility_regulatory_profile_id") @db.Uuid
  insuranceMembershipId       String?  @map("insurance_membership_id") @db.Uuid
  payerId                     String?  @map("payer_id") @db.Uuid
  tpaId                       String?  @map("tpa_id") @db.Uuid
  networkId                   String?  @map("network_id") @db.Uuid
  insuranceProductId          String?  @map("insurance_product_id") @db.Uuid
  providerContractId          String?  @map("provider_contract_id") @db.Uuid
  tariffScheduleId            String?  @map("tariff_schedule_id") @db.Uuid
  tariffScheduleVersionId     String?  @map("tariff_schedule_version_id") @db.Uuid
  validatorVersion            String   @map("validator_version") @db.Text
  evaluatedAt                 DateTime @map("evaluated_at") @db.Timestamptz(6)
  createdByUserId             String   @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  encounter                 Encounter                 @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility                  Facility                  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  facilityRegulatoryProfile FacilityRegulatoryProfile @relation(fields: [facilityRegulatoryProfileId], references: [id], onDelete: Restrict)
  insuranceMembership       InsuranceMembership?      @relation(fields: [insuranceMembershipId], references: [id], onDelete: Restrict)
  payer                     Payer?                    @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tpa                       Tpa?                      @relation(fields: [tpaId], references: [id], onDelete: Restrict)
  network                   Network?                  @relation(fields: [networkId], references: [id], onDelete: Restrict)
  insuranceProduct          InsuranceProduct?         @relation(fields: [insuranceProductId], references: [id], onDelete: Restrict)
  providerContract          ProviderContract?         @relation(fields: [providerContractId], references: [id], onDelete: Restrict)
  tariffSchedule            TariffSchedule?           @relation(fields: [tariffScheduleId], references: [id], onDelete: Restrict)
  tariffScheduleVersion     TariffScheduleVersion?    @relation(fields: [tariffScheduleVersionId], references: [id], onDelete: Restrict)
  createdBy                 User                      @relation("ValidationRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  findings                  ValidationFinding[]
  readinessAssessments PreClaimReadinessAssessment[]

  @@index([encounterId, evaluatedAt])
  @@index([providerContractId])
  @@index([tariffScheduleVersionId])
  @@map("validation_runs")
}

// A5.7 — one immutable, ordered result inside a ValidationRun. findingCode is the machine-readable
// contract downstream consumes; message is frozen human text that is never parsed. Provenance and
// target references are optional exact ids, never inferred from fieldPath or message. There is
// deliberately no claimLineId: ClaimLine is A6's, which may add a nullable relation later.
model ValidationFinding {
  id                          String   @id @default(uuid()) @db.Uuid
  validationRunId             String   @map("validation_run_id") @db.Uuid
  sequence                    Int
  layer                       String   @db.Text
  outcome                     String   @db.Text
  findingCode                 String   @map("finding_code") @db.Text
  fieldPath                   String?  @map("field_path") @db.Text
  message                     String   @db.Text
  ruleVersionId               String?  @map("rule_version_id") @db.Uuid
  governingSourceVersionId    String?  @map("governing_source_version_id") @db.Uuid
  referenceDatasetVersionId   String?  @map("reference_dataset_version_id") @db.Uuid
  encounterActivityId         String?  @map("encounter_activity_id") @db.Uuid
  encounterDiagnosisId        String?  @map("encounter_diagnosis_id") @db.Uuid
  eligibilityVerificationId   String?  @map("eligibility_verification_id") @db.Uuid
  priorAuthorizationVersionId String?  @map("prior_authorization_version_id") @db.Uuid
  authorizationLineId         String?  @map("authorization_line_id") @db.Uuid
  evidenceRequirementId       String?  @map("evidence_requirement_id") @db.Uuid
  evidenceArtifactVersionId   String?  @map("evidence_artifact_version_id") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  validationRun             ValidationRun              @relation(fields: [validationRunId], references: [id], onDelete: Restrict)
  ruleVersion               RuleVersion?               @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  governingSourceVersion    RuleSourceVersion?         @relation(fields: [governingSourceVersionId], references: [id], onDelete: Restrict)
  referenceDatasetVersion   ReferenceDatasetVersion?   @relation(fields: [referenceDatasetVersionId], references: [id], onDelete: Restrict)
  encounterActivity         EncounterActivity?         @relation(fields: [encounterActivityId], references: [id], onDelete: Restrict)
  encounterDiagnosis        EncounterDiagnosis?        @relation(fields: [encounterDiagnosisId], references: [id], onDelete: Restrict)
  eligibilityVerification   EligibilityVerification?   @relation(fields: [eligibilityVerificationId], references: [id], onDelete: Restrict)
  priorAuthorizationVersion PriorAuthorizationVersion? @relation(fields: [priorAuthorizationVersionId], references: [id], onDelete: Restrict)
  authorizationLine         AuthorizationLine?         @relation(fields: [authorizationLineId], references: [id], onDelete: Restrict)
  evidenceRequirement       EvidenceRequirement?       @relation(fields: [evidenceRequirementId], references: [id], onDelete: Restrict)
  evidenceArtifactVersion   EvidenceArtifactVersion?   @relation(fields: [evidenceArtifactVersionId], references: [id], onDelete: Restrict)
  ruleProvenance          ValidationFindingRuleProvenance?
  supportingBindings      ValidationFindingSupportingBinding[]
  matchedApplicabilities  ValidationFindingMatchedApplicability[]
  consumedDatasetVersions ValidationFindingReferenceDatasetVersion[]

  @@unique([validationRunId, sequence])
  @@index([validationRunId])
  @@index([layer, outcome])
  @@index([findingCode])
  @@index([ruleVersionId])
  @@map("validation_findings")
}

// A5.8 — the exact A3-PROV-1 decision basis of one governed ValidationFinding, normalized so it can be
// reconstructed without JSON. Exactly one row per governed finding; a pure system-invariant finding
// has none (validatorVersion is its execution provenance). Append-only, and only ever written in the
// transaction that recorded its finding.
model ValidationFindingRuleProvenance {
  validationFindingId             String   @id @map("validation_finding_id") @db.Uuid
  provenanceContractVersion       String   @map("provenance_contract_version") @db.Text
  precedencePolicyVersion         String   @map("precedence_policy_version") @db.Text
  rulePackVersionId               String?  @map("rule_pack_version_id") @db.Uuid
  governingBindingId              String   @map("governing_binding_id") @db.Uuid
  governingSourceInterpretationId String   @map("governing_source_interpretation_id") @db.Uuid
  businessDate                    DateTime @map("business_date") @db.Date
  evaluationTimestamp             DateTime @map("evaluation_timestamp") @db.Timestamptz(6)
  historicalOnly                  Boolean  @map("historical_only")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  validationFinding               ValidationFinding    @relation(fields: [validationFindingId], references: [id], onDelete: Restrict)
  rulePackVersion                 RulePackVersion?     @relation(fields: [rulePackVersionId], references: [id], onDelete: Restrict)
  governingBinding                RuleSourceBinding    @relation(fields: [governingBindingId], references: [id], onDelete: Restrict)
  governingSourceInterpretation   SourceInterpretation @relation(fields: [governingSourceInterpretationId], references: [id], onDelete: Restrict)

  @@index([governingBindingId])
  @@index([rulePackVersionId])
  @@map("validation_finding_rule_provenances")
}

// A5.8 — the exact supporting bindings A3-PROV-1 named for a governed finding. Never a latest/current
// substitution.
model ValidationFindingSupportingBinding {
  validationFindingId String   @map("validation_finding_id") @db.Uuid
  ruleSourceBindingId String   @map("rule_source_binding_id") @db.Uuid

  validationFinding ValidationFinding @relation(fields: [validationFindingId], references: [id], onDelete: Restrict)
  ruleSourceBinding RuleSourceBinding @relation(fields: [ruleSourceBindingId], references: [id], onDelete: Restrict)

  @@id([validationFindingId, ruleSourceBindingId])
  @@index([ruleSourceBindingId])
  @@map("validation_finding_supporting_bindings")
}

// A5.8 — the exact RuleApplicability rows A3.8 matched for a governed finding.
model ValidationFindingMatchedApplicability {
  validationFindingId String   @map("validation_finding_id") @db.Uuid
  ruleApplicabilityId String   @map("rule_applicability_id") @db.Uuid

  validationFinding ValidationFinding @relation(fields: [validationFindingId], references: [id], onDelete: Restrict)
  ruleApplicability RuleApplicability @relation(fields: [ruleApplicabilityId], references: [id], onDelete: Restrict)

  @@id([validationFindingId, ruleApplicabilityId])
  @@index([ruleApplicabilityId])
  @@map("validation_finding_matched_applicabilities")
}

// A5.8 — every exact ReferenceDatasetVersion a governed finding actually consumed. A5-VAL-1 consumes
// none; the table exists so a future typed executor records them without rewriting history.
model ValidationFindingReferenceDatasetVersion {
  validationFindingId       String   @map("validation_finding_id") @db.Uuid
  referenceDatasetVersionId String   @map("reference_dataset_version_id") @db.Uuid

  validationFinding       ValidationFinding       @relation(fields: [validationFindingId], references: [id], onDelete: Restrict)
  referenceDatasetVersion ReferenceDatasetVersion @relation(fields: [referenceDatasetVersionId], references: [id], onDelete: Restrict)

  @@id([validationFindingId, referenceDatasetVersionId])
  @@index([referenceDatasetVersionId])
  @@map("validation_finding_reference_dataset_versions")
}

// A5.9 — one immutable readiness decision for one exact ValidationRun under one readiness policy
// version. The state is a deterministic reduction of that run's immutable finding outcomes; counts,
// reasons, context and provenance are never copied here because the run owns them. There is no
// current/latest pointer and no claim, approval or payer state: a later validation is another run with
// its own assessment.
model PreClaimReadinessAssessment {
  id                     String   @id @default(uuid()) @db.Uuid
  validationRunId        String   @map("validation_run_id") @db.Uuid
  readinessPolicyVersion String   @map("readiness_policy_version") @db.Text
  state                  String   @db.Text
  assessedAt             DateTime @map("assessed_at") @db.Timestamptz(6)
  createdByUserId        String   @map("created_by_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  validationRun ValidationRun @relation(fields: [validationRunId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("PreClaimReadinessAssessmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  claim         Claim?
  claimDraftAssessments ClaimDraftAssessment[]

  @@unique([validationRunId, readinessPolicyVersion])
  @@index([validationRunId])
  @@index([state, assessedAt])
  @@map("pre_claim_readiness_assessments")
}

// A6.1 — the stable internal billing-case identity, bound forever to the one exact READY_FOR_REVIEW
// readiness assessment that established it (A6-CLAIM-1 over PreClaimA6HandoffV1). It is not a
// submission: there are no lines, money, lifecycle state, approval or payload here. Organization, payer,
// facility, regulatory profile, run and readiness state are never copied — they are reached through the
// exact bound A5 chain, so they cannot contradict it. One assessment creates at most one Claim; one
// Encounter may have many.
model Claim {
  id                            String   @id @default(uuid()) @db.Uuid
  encounterId                   String   @map("encounter_id") @db.Uuid
  preClaimReadinessAssessmentId String   @unique @map("pre_claim_readiness_assessment_id") @db.Uuid
  claimContractVersion          String   @map("claim_contract_version") @db.Text
  handoffSchemaVersion          String   @map("handoff_schema_version") @db.Text
  createdByUserId               String   @map("created_by_user_id") @db.Uuid
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  encounter                   Encounter                   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  preClaimReadinessAssessment PreClaimReadinessAssessment @relation(fields: [preClaimReadinessAssessmentId], references: [id], onDelete: Restrict)
  createdBy                   User                        @relation("ClaimCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                       ClaimLine[]
  pricingRuns                 ClaimPricingRun[]
  draftAssessments            ClaimDraftAssessment[]
  diagnoses                   ClaimDiagnosis[]
  reviewDecisions             ClaimReviewEvent[]
  freezes                     ClaimFreeze[]

  @@index([encounterId, createdAt])
  @@map("claims")
}

// A6.2 — a stable draft billing-line identity under one A6.1 Claim (A6-LINE-1). It is not an external
// Activity row and not a submitted snapshot. Service, procedure, quantity, unit and modifiers are never
// copied here: they are read from the exact source EncounterActivity recorded in ClaimLineSourceActivity.
// sequence is the Claim-specific order among ACTIVE lines and is written only by the server; removal is
// one-way and the row is kept as history. No price, lifecycle, approval, payload or submission field.
model ClaimLine {
  id                       String    @id @default(uuid()) @db.Uuid
  claimId                  String    @map("claim_id") @db.Uuid
  sequence                 Int
  claimLineContractVersion String    @map("claim_line_contract_version") @db.Text
  removedAt                DateTime? @map("removed_at") @db.Timestamptz(6)
  createdByUserId          String    @map("created_by_user_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  claim             Claim                       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  createdBy         User                        @relation("ClaimLineCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sources           ClaimLineSourceActivity[]
  diagnosisPointers ClaimLineDiagnosisPointer[]
  pricingLineResults ClaimPricingLineResult[]
  draftFindings      ClaimDraftFinding[]

  @@index([claimId, removedAt])
  @@map("claim_lines")
}

// A6.2 — the immutable record of which exact EncounterActivity a ClaimLine was created from. One source
// per line in A6-LINE-1; the separate table leaves room for later composite sources without changing
// ClaimLine identity. Never updated, never deleted.
model ClaimLineSourceActivity {
  id                  String   @id @default(uuid()) @db.Uuid
  claimLineId         String   @map("claim_line_id") @db.Uuid
  encounterActivityId String   @map("encounter_activity_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claimLine         ClaimLine         @relation(fields: [claimLineId], references: [id], onDelete: Restrict)
  encounterActivity EncounterActivity @relation(fields: [encounterActivityId], references: [id], onDelete: Restrict)

  @@unique([claimLineId, encounterActivityId])
  @@index([encounterActivityId])
  @@map("claim_line_source_activities")
}

// A6.2 — a Claim-specific diagnosis selection (A6-DX-1): one exact EncounterDiagnosis with an explicit
// canonical role and a Claim-specific order. The ICD code and text are never copied; the role is never
// inferred from the Encounter order and is corrected only by remove + re-add.
model ClaimDiagnosis {
  id                            String    @id @default(uuid()) @db.Uuid
  claimId                       String    @map("claim_id") @db.Uuid
  encounterDiagnosisId          String    @map("encounter_diagnosis_id") @db.Uuid
  sequence                      Int
  roleCode                      String    @map("role_code") @db.Text
  claimDiagnosisContractVersion String    @map("claim_diagnosis_contract_version") @db.Text
  removedAt                     DateTime? @map("removed_at") @db.Timestamptz(6)
  createdByUserId               String    @map("created_by_user_id") @db.Uuid
  createdAt                     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  claim              Claim                       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  encounterDiagnosis EncounterDiagnosis          @relation(fields: [encounterDiagnosisId], references: [id], onDelete: Restrict)
  createdBy          User                        @relation("ClaimDiagnosisCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  linePointers       ClaimLineDiagnosisPointer[]
  draftFindings      ClaimDraftFinding[]

  @@index([claimId, removedAt])
  @@index([encounterDiagnosisId])
  @@map("claim_diagnoses")
}

// A6.2 — an optional internal link from one ClaimLine to one ClaimDiagnosis of the same Claim. There is
// no pointer order column: the order is ClaimDiagnosis.sequence. Removal is one-way history.
model ClaimLineDiagnosisPointer {
  id               String    @id @default(uuid()) @db.Uuid
  claimLineId      String    @map("claim_line_id") @db.Uuid
  claimDiagnosisId String    @map("claim_diagnosis_id") @db.Uuid
  removedAt        DateTime? @map("removed_at") @db.Timestamptz(6)
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  claimLine      ClaimLine      @relation(fields: [claimLineId], references: [id], onDelete: Restrict)
  claimDiagnosis ClaimDiagnosis @relation(fields: [claimDiagnosisId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("ClaimLineDiagnosisPointerCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([claimLineId, removedAt])
  @@index([claimDiagnosisId, removedAt])
  @@map("claim_line_diagnosis_pointers")
}

// A6.3 — one governed tariff rate (A6-RATE-1) owned by one exact TariffScheduleVersion. A rate matches
// exactly one source identity (SERVICE or PROCEDURE_CODE), one exact unit (null means "no unit", never a
// wildcard) and one canonical sorted modifier set (the empty set is a real signature). Rates are written
// and retired only while the parent version is UNVERIFIED; once verified they never change. A corrected
// price is a new governed tariff version. The amount is a tariff amount, never payer Net or patient share.
model TariffRate {
  id                      String    @id @default(uuid()) @db.Uuid
  tariffScheduleVersionId String    @map("tariff_schedule_version_id") @db.Uuid
  selectorKind            String    @map("selector_kind") @db.Text
  serviceId               String?   @map("service_id") @db.Uuid
  procedureCodeId         String?   @map("procedure_code_id") @db.Uuid
  unitCodeKey             String?   @map("unit_code_key") @db.Text
  modifierSignature       String[]  @map("modifier_signature") @db.Text
  currencyCode            String    @map("currency_code") @db.Text
  unitTariffAmount        Decimal   @map("unit_tariff_amount") @db.Decimal(18, 4)
  rateContractVersion     String    @map("rate_contract_version") @db.Text
  removedAt               DateTime? @map("removed_at") @db.Timestamptz(6)
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tariffScheduleVersion TariffScheduleVersion    @relation(fields: [tariffScheduleVersionId], references: [id], onDelete: Restrict)
  service               Service?                 @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  procedureCode         ProcedureCode?           @relation(fields: [procedureCodeId], references: [id], onDelete: Restrict)
  createdBy             User                     @relation("TariffRateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  pricingLineResults    ClaimPricingLineResult[]

  @@index([tariffScheduleVersionId, removedAt])
  @@index([serviceId])
  @@index([procedureCodeId])
  @@map("tariff_rates")
}

// A6.3 — one immutable draft pricing evaluation (A6-PRICE-1) of one Claim against the exact commercial
// lineage of its bound ValidationRun. PRICED only when every active line resolved to exactly one rate in
// one currency; otherwise INCOMPLETE with no total. It never approves, submits or becomes "current".
model ClaimPricingRun {
  id                        String   @id @default(uuid()) @db.Uuid
  claimId                   String   @map("claim_id") @db.Uuid
  pricingContractVersion    String   @map("pricing_contract_version") @db.Text
  tariffScheduleVersionId   String   @map("tariff_schedule_version_id") @db.Uuid
  providerContractId        String   @map("provider_contract_id") @db.Uuid
  tariffScheduleId          String   @map("tariff_schedule_id") @db.Uuid
  evaluatedAt               DateTime @map("evaluated_at") @db.Timestamptz(6)
  createdByUserId           String   @map("created_by_user_id") @db.Uuid
  inputStructureFingerprint String   @map("input_structure_fingerprint") @db.Text
  overallResult             String   @map("overall_result") @db.Text
  lineCount                 Int      @map("line_count")
  pricedCount               Int      @map("priced_count")
  currencyCode              String?  @map("currency_code") @db.Text
  totalExtendedAmount       Decimal? @map("total_extended_amount") @db.Decimal(18, 4)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim                 Claim                    @relation(fields: [claimId], references: [id], onDelete: Restrict)
  tariffScheduleVersion TariffScheduleVersion    @relation(fields: [tariffScheduleVersionId], references: [id], onDelete: Restrict)
  providerContract      ProviderContract         @relation(fields: [providerContractId], references: [id], onDelete: Restrict)
  tariffSchedule        TariffSchedule           @relation(fields: [tariffScheduleId], references: [id], onDelete: Restrict)
  createdBy             User                     @relation("ClaimPricingRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lineResults           ClaimPricingLineResult[]
  draftAssessments      ClaimDraftAssessment[]
  freezes               ClaimFreeze[]

  @@index([claimId, evaluatedAt])
  @@index([tariffScheduleVersionId])
  @@map("claim_pricing_runs")
}

// A6.3 — the immutable result of one ClaimLine inside one pricing run: the exact source activity and rate
// it used, the bounded calculation inputs and the outcome. An unpriced line carries its reason and no
// amount; nothing is invented.
model ClaimPricingLineResult {
  id                       String   @id @default(uuid()) @db.Uuid
  pricingRunId             String   @map("pricing_run_id") @db.Uuid
  claimLineId              String   @map("claim_line_id") @db.Uuid
  encounterActivityId      String   @map("encounter_activity_id") @db.Uuid
  tariffRateId             String?  @map("tariff_rate_id") @db.Uuid
  lineSequenceAtEvaluation Int      @map("line_sequence_at_evaluation")
  outcome                  String   @db.Text
  unitTariffAmount         Decimal? @map("unit_tariff_amount") @db.Decimal(18, 4)
  quantityAtEvaluation     Decimal  @map("quantity_at_evaluation") @db.Decimal(18, 4)
  extendedAmount           Decimal? @map("extended_amount") @db.Decimal(18, 4)
  currencyCode             String?  @map("currency_code") @db.Text
  inputFingerprint         String   @map("input_fingerprint") @db.Text
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pricingRun        ClaimPricingRun   @relation(fields: [pricingRunId], references: [id], onDelete: Restrict)
  claimLine         ClaimLine         @relation(fields: [claimLineId], references: [id], onDelete: Restrict)
  encounterActivity EncounterActivity @relation(fields: [encounterActivityId], references: [id], onDelete: Restrict)
  tariffRate        TariffRate?       @relation(fields: [tariffRateId], references: [id], onDelete: Restrict)

  @@unique([pricingRunId, claimLineId])
  @@index([claimLineId])
  @@index([tariffRateId])
  @@map("claim_pricing_line_results")
}

// A6.4 — one immutable claim draft assessment: the exact Claim, the exact pricing run the caller named,
// the bound readiness assessment, the reduced outcome and the A6-DRAFT-1 assembly fingerprint. It is a
// candidate-for-review record, never approval, sign-off or submission state; a re-evaluation is a new row.
model ClaimDraftAssessment {
  id                      String   @id @default(uuid()) @db.Uuid
  claimId                 String   @map("claim_id") @db.Uuid
  pricingRunId            String   @map("pricing_run_id") @db.Uuid
  draftContractVersion    String   @map("draft_contract_version") @db.Text
  handoffAssessmentId     String   @map("handoff_assessment_id") @db.Uuid
  outcome                 String   @db.Text
  assemblyFingerprint     String   @map("assembly_fingerprint") @db.Text
  pricingInputFingerprint String   @map("pricing_input_fingerprint") @db.Text
  activeLineCount         Int      @map("active_line_count")
  activeDiagnosisCount    Int      @map("active_diagnosis_count")
  findingCount            Int      @map("finding_count")
  evaluatedAt             DateTime @map("evaluated_at") @db.Timestamptz(6)
  createdByUserId         String   @map("created_by_user_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim             Claim                       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  pricingRun        ClaimPricingRun             @relation(fields: [pricingRunId], references: [id], onDelete: Restrict)
  handoffAssessment PreClaimReadinessAssessment @relation(fields: [handoffAssessmentId], references: [id], onDelete: Restrict)
  createdBy         User                        @relation("ClaimDraftAssessmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  findings          ClaimDraftFinding[]
  reviewDecisions   ClaimReviewEvent[]
  freezes           ClaimFreeze[]

  @@index([claimId, evaluatedAt])
  @@index([pricingRunId])
  @@index([handoffAssessmentId])
  @@map("claim_draft_assessments")
}

// A6.4 — one structured finding of an assessment: a catalogue code, its severity and owner scope, and the
// exact line or diagnosis it is about. No free text, PHI or copied evidence. Append-only.
model ClaimDraftFinding {
  id                      String   @id @default(uuid()) @db.Uuid
  draftAssessmentId       String   @map("draft_assessment_id") @db.Uuid
  ordinal                 Int
  findingCode             String   @map("finding_code") @db.Text
  severity                String   @db.Text
  ownerScope              String   @map("owner_scope") @db.Text
  relatedClaimLineId      String?  @map("related_claim_line_id") @db.Uuid
  relatedClaimDiagnosisId String?  @map("related_claim_diagnosis_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  draftAssessment       ClaimDraftAssessment @relation(fields: [draftAssessmentId], references: [id], onDelete: Restrict)
  relatedClaimLine      ClaimLine?           @relation(fields: [relatedClaimLineId], references: [id], onDelete: Restrict)
  relatedClaimDiagnosis ClaimDiagnosis?      @relation(fields: [relatedClaimDiagnosisId], references: [id], onDelete: Restrict)

  @@unique([draftAssessmentId, ordinal])
  @@index([relatedClaimLineId])
  @@index([relatedClaimDiagnosisId])
  @@map("claim_draft_findings")
}

// A6.5 — one immutable human review decision (A6-REVIEW-1) about one exact A6.4 draft assessment of a
// Claim: APPROVE, RETURN, REJECT or REVOKE, at a Claim-local sequence, by the authenticated reviewer, at the
// database's own time. Current approval authority is DERIVED from the latest decision by sequence plus a
// fresh A6.4 currentness check; there is no approval state on the Claim and no latest-approval pointer. An
// APPROVE is a human authorization record only, never a submission, payload or transport. Append-only.
model ClaimReviewEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  claimId               String   @map("claim_id") @db.Uuid
  draftAssessmentId     String   @map("draft_assessment_id") @db.Uuid
  reviewerUserId        String   @map("reviewer_user_id") @db.Uuid
  decisionCode          String   @map("decision_code") @db.Text
  sequence              Int
  approvalFingerprint   String?  @map("approval_fingerprint") @db.Text
  reasonCode            String?  @map("reason_code") @db.Text
  referencedApprovalId  String?  @unique @map("referenced_approval_id") @db.Uuid
  reviewedAt            DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  reviewContractVersion String   @map("review_contract_version") @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim              Claim                @relation(fields: [claimId], references: [id], onDelete: Restrict)
  draftAssessment    ClaimDraftAssessment @relation(fields: [draftAssessmentId], references: [id], onDelete: Restrict)
  reviewer           User                 @relation("ClaimReviewEventReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  referencedApproval ClaimReviewEvent? @relation("ClaimReviewRevocation", fields: [referencedApprovalId], references: [id], onDelete: Restrict)
  revocation         ClaimReviewEvent? @relation("ClaimReviewRevocation")
  freeze             ClaimFreeze?

  @@unique([claimId, sequence])
  @@index([draftAssessmentId])
  @@index([reviewerUserId])
  @@map("claim_review_events")
}

// A6.7 — one immutable internal freeze (A6-SUBMISSION-1) of an approved, current Claim: the exact A6.6
// canonical bytes, their SHA-256, the exact A6.4 draft assessment, the A6.5 APPROVE event and the A6.3
// pricing run, at the database's own time. It is a custody record, never a transmission: no status, no
// payer identifier, no acknowledgement. One freeze per approval. Append-only. (Business name:
// ClaimSubmission; the physical name avoids the accepted A6.1–A6.6 "no submission yet" phase guards.)
model ClaimFreeze {
  id                          String   @id @default(uuid()) @db.Uuid
  claimId                     String   @map("claim_id") @db.Uuid
  draftAssessmentId           String   @map("draft_assessment_id") @db.Uuid
  approvalReviewEventId       String   @unique @map("approval_review_event_id") @db.Uuid
  pricingRunId                String   @map("pricing_run_id") @db.Uuid
  submissionContractVersion   String   @map("submission_contract_version") @db.Text
  payloadSchemaVersion        String   @map("payload_schema_version") @db.Text
  approvedAssemblyFingerprint String   @map("approved_assembly_fingerprint") @db.Char(64)
  canonicalPayloadBytes       Bytes    @map("canonical_payload_bytes")
  payloadSha256               String   @map("payload_sha256") @db.Char(64)
  frozenAt                    DateTime @default(now()) @map("frozen_at") @db.Timestamptz(6)
  createdByUserId             String   @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim            Claim                        @relation(fields: [claimId], references: [id], onDelete: Restrict)
  draftAssessment  ClaimDraftAssessment         @relation(fields: [draftAssessmentId], references: [id], onDelete: Restrict)
  approvalEvent    ClaimReviewEvent             @relation(fields: [approvalReviewEventId], references: [id], onDelete: Restrict)
  pricingRun       ClaimPricingRun              @relation(fields: [pricingRunId], references: [id], onDelete: Restrict)
  createdBy        User                         @relation("ClaimFreezeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  evidenceManifest ClaimFreezeEvidenceManifest?
  lifecycleEvents  ClaimFreezeLifecycleEvent[]

  @@index([claimId, frozenAt])
  @@index([draftAssessmentId])
  @@index([pricingRunId])
  @@map("claim_freezes")
}

// A6.7 — the one evidence package (A6-EVIDENCE-1) of a freeze: the exact canonical manifest bytes, their
// SHA-256 and the package seal over the payload digest, the manifest digest and the freeze identity.
// Append-only.
model ClaimFreezeEvidenceManifest {
  id                      String   @id @default(uuid()) @db.Uuid
  claimFreezeId           String   @unique @map("claim_submission_id") @db.Uuid
  manifestContractVersion String   @map("manifest_contract_version") @db.Text
  entryCount              Int      @map("entry_count")
  manifestBytes           Bytes    @map("manifest_bytes")
  manifestSha256          String   @map("manifest_sha256") @db.Char(64)
  packageSealSha256       String   @map("package_seal_sha256") @db.Char(64)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claimFreeze ClaimFreeze                @relation(fields: [claimFreezeId], references: [id], onDelete: Restrict)
  entries     ClaimFreezeEvidenceEntry[]

  @@map("claim_freeze_evidence_manifests")
}

// A6.7 — one ordered, typed evidence reference of a package: which owner row (and version) the approved
// payload rests on, and the owner's own SHA-256 only where the owner guarantees one. No copied evidence
// bytes, display text or reason. Append-only.
model ClaimFreezeEvidenceEntry {
  id                 String   @id @default(uuid()) @db.Uuid
  evidenceManifestId String   @map("evidence_package_id") @db.Uuid
  ordinal            Int
  referenceKind      String   @map("reference_kind") @db.Text
  referenceId        String   @map("reference_id") @db.Uuid
  referenceVersionId String?  @map("reference_version_id") @db.Uuid
  contentHash        String?  @map("content_hash") @db.Char(64)
  evidenceRole       String   @map("evidence_role") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  evidenceManifest ClaimFreezeEvidenceManifest @relation(fields: [evidenceManifestId], references: [id], onDelete: Restrict)

  @@unique([evidenceManifestId, ordinal])
  @@map("claim_freeze_evidence_entries")
}

// A6.8 — one append-only internal lifecycle event (A6-LIFECYCLE-1) of a frozen ClaimSubmission: an explicit,
// typed PLACE_HOLD, RELEASE_HOLD, AUTHORIZE_RELEASE or WITHDRAW_INTERNAL decision at the next
// submission-local sequence, by an authenticated person, at the database's own time. The current
// disposition is derived from these events, never stored; an untouched freeze is FROZEN without a row.
// Internal only: no send, payer status, acknowledgement or payment.
model ClaimFreezeLifecycleEvent {
  id                       String   @id @default(uuid()) @db.Uuid
  claimFreezeId            String   @map("claim_submission_id") @db.Uuid
  sequence                 Int
  eventCode                String   @map("event_code") @db.Text
  reasonCode               String?  @map("reason_code") @db.Text
  actorUserId              String   @map("actor_user_id") @db.Uuid
  occurredAt               DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  lifecycleContractVersion String   @map("lifecycle_contract_version") @db.Text
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claimFreeze ClaimFreeze @relation(fields: [claimFreezeId], references: [id], onDelete: Restrict)
  actor       User        @relation("ClaimFreezeLifecycleEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([claimFreezeId, sequence])
  @@index([actorUserId])
  @@map("claim_freeze_lifecycle_events")
}
